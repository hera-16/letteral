# ==========================================
# Multi-stage Dockerfile for Production (AWS ECS)
# Letteral Backend - Spring Boot Application
# ==========================================

# ------------------------------------------
# Stage 1: Build stage
# ------------------------------------------
FROM maven:3.9-eclipse-temurin-17 AS build

WORKDIR /app

# Copy pom.xml and download dependencies (cached layer)
COPY pom.xml .
RUN mvn -B -Dmaven.wagon.http.retryHandler.count=5 dependency:go-offline || true

# Copy source code
COPY src ./src

# Build the application (skip tests in production build)
RUN mvn clean package -DskipTests -Dmaven.test.skip=true

# Verify the JAR was created
RUN ls -lh /app/target/*.jar

# ------------------------------------------
# Stage 2: Runtime stage (Production-optimized)
# ------------------------------------------
FROM eclipse-temurin:17-jre-alpine

# Install required packages
RUN apk add --no-cache \
    curl \
    ca-certificates \
    tzdata

# Set timezone to Asia/Tokyo
ENV TZ=Asia/Tokyo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /app

# Create non-root user for security
RUN addgroup -S spring && adduser -S spring -G spring

# Create log directory
RUN mkdir -p /var/log/letteral && chown -R spring:spring /var/log/letteral

# Copy the built JAR from build stage
COPY --from=build --chown=spring:spring /app/target/*.jar app.jar

# Switch to non-root user
USER spring:spring

# Expose application port
EXPOSE 8080

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health || exit 1

# JVM tuning for production containers
# - UseContainerSupport: Automatically detect container resources
# - MaxRAMPercentage: Use up to 75% of container memory
# - InitialRAMPercentage: Start with 50% of container memory
# - +UseG1GC: Use G1 Garbage Collector (good for server apps)
# - MaxGCPauseMillis: Target max GC pause time
# - +HeapDumpOnOutOfMemoryError: Create heap dump on OOM
# - HeapDumpPath: Where to save heap dumps
ENV JAVA_OPTS="-XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:InitialRAMPercentage=50.0 \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/var/log/letteral/heap-dump.hprof \
    -Djava.security.egd=file:/dev/./urandom"

# Run the application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

# Labels for container metadata
LABEL maintainer="Letteral Team"
LABEL application="letteral-backend"
LABEL environment="production"
LABEL version="1.0.0"
